---
import { getEntry, render } from "astro:content";
import AboutExperience from "../components/AboutExperience.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "about");

if (!page) {
  throw new Error("Missing src/content/pages/about.md");
}

const { Content } = await render(page);
---

<BaseLayout title={`${page.data.title} | Backpropaganda`} description={page.data.description}>
  <AboutExperience title={page.data.title}>
    <Content />
  </AboutExperience>
</BaseLayout>
