---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";

const page = await getEntry("pages", "join");

if (!page) {
  throw new Error("Missing src/content/pages/join.md");
}

const { Content } = await render(page);
const jobs = page.data.jobs ?? [];
---

<BaseLayout title={`${page.data.title} | Backpropaganda`} description={page.data.description}>
  <section class="join-page">
    <div class="dot-corner dot-corner--top-left" aria-hidden="true"></div>
    <div class="dot-corner dot-corner--top-right" aria-hidden="true"></div>
    <div class="join-intro">
      <h1>{page.data.title}</h1>
      <div class="markdown-copy">
        <Content />
      </div>
      {page.data.email && <a class="email-link" href={`mailto:${page.data.email}`}>{page.data.email} -></a>}
    </div>
    <div class="jobs-list" aria-label="Open roles">
      {
        jobs.map((job) => (
          <article class="job-row">
            <div>
              <h2>{job.title}</h2>
              <span>{job.type}</span>
            </div>
            <a href={job.href}>Read more</a>
          </article>
        ))
      }
    </div>
  </section>
  <SiteFooter />
</BaseLayout>
