---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchCard from "../components/ResearchCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Research | Backpropaganda" description="Markdown-backed essays, releases, and technical vignettes.">
  <section class="research-index">
    <div class="dot-corner dot-corner--top-left" aria-hidden="true"></div>
    <div class="dot-corner dot-corner--top-right" aria-hidden="true"></div>
    <h1>Research</h1>
    <div class="research-grid">
      {posts.map((post) => <ResearchCard post={post} />)}
    </div>
  </section>
</BaseLayout>
