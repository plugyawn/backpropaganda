---
import Logo from "./Logo.astro";
import { stripBase, withBase } from "../lib/paths";

const nav = [
  { href: "/about/", label: "About" },
  { href: "/join/", label: "Join" }
];

const pathname = stripBase(Astro.url.pathname);
const currentPath = pathname.endsWith("/") ? pathname : `${pathname}/`;
const navPath = currentPath === "/" ? "/about/" : currentPath;
---

<header class="site-header">
  <Logo />

  <nav class="desktop-nav" aria-label="Primary navigation">
    {
      nav.map((item) => (
        <a
          class:list={{ active: navPath === item.href }}
          href={withBase(item.href)}
          aria-current={navPath === item.href ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <details class="mobile-nav">
    <summary aria-label="Open navigation">
      <span></span>
      <span></span>
    </summary>
    <nav aria-label="Mobile navigation">
      {
        nav.map((item) => (
          <a
            class:list={{ active: navPath === item.href }}
            href={withBase(item.href)}
            aria-current={navPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </details>
</header>
