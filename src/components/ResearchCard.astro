---
import ArticleVisual from "./ArticleVisual.astro";

interface Props {
  post: {
    slug?: string;
    id?: string;
    data: {
      title: string;
      description: string;
      category: string;
      displayDate: string;
      visual: string;
    };
  };
}

const { post } = Astro.props;
const slug = post.slug ?? post.id?.replace(/\.md$/, "");
---

<article class="research-card">
  <a href={`/blog/${slug}/`} aria-label={`Read ${post.data.title}`}>
    <ArticleVisual title={post.data.title} visual={post.data.visual} />
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    <div class="article-meta">
      <span>{post.data.category}</span>
      <time>{post.data.displayDate}</time>
    </div>
  </a>
</article>
