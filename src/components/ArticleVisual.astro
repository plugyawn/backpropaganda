const dots = dotSets[visual] ?? dotSets.aurora;
---

<div class:list={["article-visual", `article-visual--${visual}`]}>
  <svg viewBox="0 0 640 300" role="img" aria-label={`${title} dot composition`}>
    <rect width="640" height="300" />
    <text x="44" y="164">{label}</text>
    <g class="visual-dots">
      {dots.map(([cx, cy, r, opacity]) => <circle cx={cx} cy={cy} r={r} opacity={opacity} />)}
    </g>
  </svg>
</div>
