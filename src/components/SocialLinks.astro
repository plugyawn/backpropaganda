---
const links = [
  { href: "https://x.com/", label: "Twitter" },
  { href: "https://www.linkedin.com/", label: "LinkedIn" },
  { href: "https://github.com/", label: "GitHub" }
];
---

<nav class="social-links" aria-label="Social links">
  {
    links.map((link) => (
      <a href={link.href} target="_blank" rel="noreferrer">
        {link.label}
      </a>
    ))
  }
</nav>
