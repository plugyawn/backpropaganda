---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class:list={["logo", { "logo--compact": compact }]} href="/" aria-label="Backpropaganda home">
  <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M6 16c8-7 16 7 24 0s16-7 28 0" />
    <path d="M6 32c8-7 16 7 24 0s16-7 28 0" />
    <path d="M6 48c8-7 16 7 24 0s16-7 28 0" />
  </svg>
  {!compact && <span class="logo-text">Backpropaganda</span>}
</a>
