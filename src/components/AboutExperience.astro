---
import DendriteShader from "./DendriteShader.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="text-page text-page--about">
  <div class="dot-grid" aria-hidden="true"></div>
  <DendriteShader />
  <div class="dot-corner dot-corner--top-left" aria-hidden="true"></div>
  <div class="dot-corner dot-corner--top-right" aria-hidden="true"></div>
  <div class="dot-corner dot-corner--bottom-left" aria-hidden="true"></div>
  <div class="dot-corner dot-corner--bottom-right" aria-hidden="true"></div>
  <article class="text-panel markdown-copy">
    <h1>{title}</h1>
    <slot />
  </article>
</section>
