---
import Header from "../components/Header.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "Backpropaganda",
  description = "A markdown-backed static website for Backpropaganda.",
  bodyClass = ""
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.svg?v=2")} type="image/svg+xml" />
    <link
      rel="preload"
      href={withBase("/fonts/Lancelot.ttf")}
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/QuattrocentoSans-Regular.ttf")}
      as="font"
      type="font/ttf"
      crossorigin
    />
  </head>
  <body class={bodyClass}>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
